# ── Supabase (Project Settings → API). Service role key is server-only. ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes, base64. Generate once, back it up — losing it loses every stored login.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=

# Session cookie signing secret — any random string, 32+ chars.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Discord (Developer Portal → your application) ──
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Buyers' Discord IDs that get the admin tab (comma separated)
ADMIN_DISCORD_IDS=
# Optional: register slash commands to one server instantly instead of globally
DISCORD_GUILD_ID=
# Optional: private staff channel for sale/payment logs
DISCORD_LOG_CHANNEL_ID=
# Optional: public channel where drop announcements get posted
DISCORD_DROPS_CHANNEL_ID=
# Discord role IDs that match our sub tiers (create them in the server first)
DISCORD_ROLE_ROOKIE=
DISCORD_ROLE_GRINDER=
DISCORD_ROLE_OPERATOR=

# OAuth redirect must be PUBLIC_BASE_URL + /api/auth/callback
# Add that exact URL in Discord → OAuth2 → Redirects.
PUBLIC_BASE_URL=https://valunlock.online

# ── NOWPayments (Settings → Payments) ──
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
FULFIL_ON_CONFIRMED=false

# ── QVSP partner API ──
# Base URL rarely changes; override only if they give you a sandbox.
QVSP_API_BASE=https://nfa.qvsp.net/partner/v1
QVSP_API_KEY=

# Random string; Vercel Cron sends it as a Bearer token
CRON_SECRET=
